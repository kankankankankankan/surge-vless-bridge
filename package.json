{
  "name": "surge-vless-bridge",
  "version": "1.5.19",
  "description": "Surge Mac VLESS support via sing-box: a Node.js CLI that converts VLESS subscriptions (including REALITY / XTLS Vision nodes) into Surge external proxy entries and policy groups.",
  "license": "MIT",
  "author": "chen86860",
  "keywords": [
    "surge",
    "surge-mac",
    "vless",
    "vless-subscription",
    "sing-box",
    "reality",
    "xtls",
    "xtls-rprx-vision",
    "external-proxy",
    "subscription-converter",
    "proxy",
    "macos-proxy",
    "cli",
    "macos"
  ],
  "homepage": "https://github.com/kankankankankankan/surge-vless-bridge#readme",
  "bugs": {
    "url": "https://github.com/kankankankankankan/surge-vless-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kankankankankankan/surge-vless-bridge.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/cli.js",
  "bin": {
    "surge-vless-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "build:desktop": "npm run build && node scripts/copy-desktop-assets.mjs",
    "desktop:icon": "node scripts/generate-app-icon.mjs",
    "desktop": "npm run build:desktop && electron dist/desktop/main.js",
    "desktop:package": "npm run build:desktop && electron-builder --mac dir",
    "desktop:dmg": "npm run build:desktop && electron-builder --mac dmg",
    "desktop:smoke": "node scripts/smoke-packaged-scheduler.mjs",
    "desktop:verify": "node scripts/verify-packaged-gui.mjs",
    "init": "tsx src/cli.ts init",
    "sync": "tsx src/cli.ts sync",
    "rebuild": "tsx src/cli.ts rebuild",
    "doctor": "tsx src/cli.ts doctor",
    "restore": "tsx src/cli.ts restore",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "build": {
    "appId": "com.chen86860.surgevlessbridge",
    "productName": "Surge VLESS Bridge",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "dist/**/*.js",
      "dist/**/*.map"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop",
        "to": "renderer",
        "filter": [
          "index.html",
          "styles.css",
          "app.js"
        ]
      },
      {
        "from": "node_modules/lucide/dist/umd/lucide.min.js",
        "to": "renderer/vendor/lucide.js"
      }
    ],
    "extraMetadata": {
      "main": "dist/desktop/main.js"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "identity": "-",
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "minimumSystemVersion": "12.0",
      "icon": "desktop/assets/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    ".surge-vless-bridge.example.json"
  ],
  "devDependencies": {
    "@types/node": "^25.5.2",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "lucide": "^1.61.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
